generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  image         String?
  passwordHash  String?
  gradeSystem   GradeSystem @default(V_SCALE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  accounts      Account[]
  sessions      ClimbSession[]
  climbs        Climb[]
  trainingNotes TrainingNote[]
  goals         Goal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Named ClimbSession to avoid conflict with NextAuth Session
model ClimbSession {
  id              String       @id @default(cuid())
  userId          String
  date            DateTime
  location        String
  locationType    LocationType @default(GYM)
  climbingType    ClimbingType @default(BOULDERING)
  durationMinutes Int?
  notes           String?
  energyLevel     Int? // 1-5
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  climbs Climb[]

  @@index([userId, date])
}

model Climb {
  id              String      @id @default(cuid())
  sessionId       String
  userId          String
  name            String?
  gradeSystem     GradeSystem @default(V_SCALE)
  grade           String // raw string: "V7", "5.12a", "7b+"
  gradeNormalized Float // 0-100 numeric for sorting/charting
  style           ClimbStyle  @default(BOULDER)
  outcome         Outcome     @default(SEND)
  attempts        Int         @default(1)
  isProject       Boolean     @default(false)
  rating          Int? // 1-5 personal enjoyment
  notes           String?
  betaVideo       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  session ClimbSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gradeNormalized])
  @@index([userId, isProject])
  @@index([sessionId])
}

model TrainingNote {
  id        String           @id @default(cuid())
  userId    String
  date      DateTime
  category  TrainingCategory @default(GENERAL)
  content   String
  tags      String[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Goal {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  targetGrade String?
  gradeSystem GradeSystem?
  targetDate  DateTime?
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
}

enum GradeSystem {
  V_SCALE
  FONT
  YDS
  FRENCH
}

enum LocationType {
  GYM
  OUTDOOR
}

enum ClimbingType {
  BOULDERING
  SPORT
  TRAD
  MULTI_PITCH
  TOP_ROPE
}

enum ClimbStyle {
  BOULDER
  SPORT
  TRAD
  TOP_ROPE
}

enum Outcome {
  SEND
  FLASH
  ONSIGHT
  ATTEMPT
  PROJECT
}

enum TrainingCategory {
  HANGBOARD
  STRENGTH
  CARDIO
  FLEXIBILITY
  MENTAL
  INJURY
  GOAL
  GENERAL
}
